#!/bin/bash
# Easy Xack | Localhost → Public Hosting Tool

R="\e[1;31m"
G="\e[1;32m"
Y="\e[1;33m"
B="\e[1;34m"
C="\e[1;36m"
RS="\e[0m"

LOG=".tunnel_log.txt"

banner() {
  clear
  echo -e "${B}"
  echo "╔═══════════════════════════════════════╗"
  echo "║      EASY X'ACK BY ALIF- Host Tool     ║"
  echo "╚═══════════════════════════════════════╝"
  echo -e "${RS}"
}

# 🔹 Function to start PHP server
start_php_server() {
  read -p $'\e[1;33mEnter Port [default:8080]: \e[0m' port
  port=${port:-8080}
  php -S 127.0.0.1:$port >/dev/null 2>&1 &
  sleep 2
  echo -e "${G}✔ Localhost started at:${Y} http://127.0.0.1:$port${RS}\n"
}

# 🔹 Cloudflared Tunnel
cloudflared_tunnel() {
  echo -e "${C}▶ Starting Cloudflared Tunnel...${RS}"
  cloudflared tunnel --url http://127.0.0.1:$port --logfile "$LOG" >/dev/null 2>&1 &
  sleep 6
  L=$(grep -oE 'https://[-0-9a-z]*\.trycloudflare.com' "$LOG" | head -1)
  [[ -n "$L" ]] && echo -e "${G}🔗 Cloudflared Link:${Y} $L${RS}" || echo -e "${R}❌ Cloudflared failed${RS}"
}

# 🔹 Serveo Tunnel
serveo_tunnel() {
  echo -e "${C}▶ Starting Serveo Tunnel...${RS}"
  ssh -o StrictHostKeyChecking=no -R 80:localhost:$port serveo.net >"$LOG" 2>&1 &
  sleep 6
  L=$(grep -oE 'https?://[^ ]+' "$LOG" | head -1)
  [[ -n "$L" ]] && echo -e "${G}🔗 Serveo Link:${Y} $L${RS}" || echo -e "${R}❌ Serveo failed${RS}"
}

# 🔹 Localhost.run Tunnel
localhostrun_tunnel() {
  echo -e "${C}▶ Starting Localhost.run Tunnel...${RS}"
  nohup ssh -o StrictHostKeyChecking=no -R 80:localhost:$port nokey@localhost.run >"$LOG" 2>&1 &
  sleep 6
  L=$(grep -oE 'https://[a-zA-Z0-9._-]*\.lhr\.life' "$LOG" | head -1)
  [[ -n "$L" ]] && echo -e "${G}🔗 Localhost.run Link:${Y} $L${RS}" || echo -e "${R}❌ Localhost.run failed${RS}"
}

# 🔹 Tunnelmole Tunnel
tunnelmole_tunnel() {
  echo -e "${C}▶ Starting Tunnelmole Tunnel...${RS}"
  tmole $port >"$LOG" 2>&1 &
  sleep 6
  L=$(grep -oE 'https://[0-9a-zA-Z.-]*tunnelmole.net' "$LOG" | head -1)
  [[ -n "$L" ]] && echo -e "${G}🔗 Tunnelmole Link:${Y} $L${RS}" || echo -e "${R}❌ Tunnelmole failed${RS}"
}

# 🔹 Main Menu
localhost_to_public() {
  banner
  start_php_server

  echo -e "${Y}Choose Public Hosting Service:${RS}"
  echo -e "${R}[1]${G} Cloudflared"
  echo -e "${R}[2]${C} Serveo"
  echo -e "${R}[3]${Y} Localhost.run"
  echo -e "${R}[4]${B} Tunnelmole"
  echo -e "${R}[0]${R} Exit${RS}\n"
  read -p $'\e[1;36mSelect Option: \e[0m' opt

  case $opt in
    1) cloudflared_tunnel ;;
    2) serveo_tunnel ;;
    3) localhostrun_tunnel ;;
    4) tunnelmole_tunnel ;;
    0) echo -e "${R}Exited.${RS}"; exit ;;
    *) echo -e "${R}Invalid option!${RS}" ;;
  esac

  echo -e "${C}\nPress Ctrl + C to stop hosting...${RS}"
  while true; do sleep 1; done
}

# 🔹 Start Script
localhost_to_public
